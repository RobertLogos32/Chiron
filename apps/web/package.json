{
  "name": "chiron-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "prettier --write src scripts tests \"*.{json,ts}\"",
    "format:check": "prettier --check src scripts tests \"*.{json,ts}\""
  },
  "dependencies": {
    "konva": "^10.9.1",
    "lucide-react": "^1.69.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
